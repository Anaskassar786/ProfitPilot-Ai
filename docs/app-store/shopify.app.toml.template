# Generated configuration. Run `pnpm generate:shopify` with deployment environment variables.
# This template intentionally contains placeholders and no client secret.
client_id = "REPLACE_WITH_SHOPIFY_API_KEY"
name = "ProfitPilot"
application_url = "https://REPLACE_WITH_APP_HOST"
embedded = true

[build]
automatically_update_urls_on_dev = true

[auth]
redirect_urls = [
  "https://REPLACE_WITH_APP_HOST/shopify/callback"
]

# Must stay identical to PROFITPILOT_SHOPIFY_SCOPES in apps/api/src/app-store-assets.ts.
# write_discounts powers the discount actions run by the AI Command Center and
# the Automation Engine (discountCodeBasicCreate / discountCodeDeactivate);
# read_price_rules still authorizes the legacy REST /price_rules.json sync.
[access_scopes]
scopes = "read_products,read_orders,read_customers,read_inventory,read_locations,read_discounts,write_discounts,read_price_rules"

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
topics = ["app/uninstalled", "orders/create", "orders/updated", "customers/create", "customers/update", "products/update", "inventory_levels/update"]
uri = "https://REPLACE_WITH_APP_HOST/shopify/webhooks"

# Mandatory GDPR compliance webhooks. The TOML is the ONLY registration
# channel for these topics — keep them in their own subscription block
# (never mixed with regular `topics`) and always use an absolute https URI.
[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "https://REPLACE_WITH_APP_HOST/shopify/webhooks"
