NODE_ENV=development
PORT=3000
WORKER_PORT=3100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/profitpilot
REDIS_URL=rediss://default:replace@upstash.example:6379
UPSTASH_REDIS_REST_URL=https://upstash.example
UPSTASH_REDIS_REST_TOKEN=replace
APP_URL=http://localhost:3000
SHOPIFY_APP_URL=REPLACE_AFTER_RAILWAY_DEPLOY
SHOPIFY_API_KEY=replace
SHOPIFY_API_SECRET=replace
# Public app key for the web bundle (App Bridge session tokens). Same value as
# SHOPIFY_API_KEY — safe to expose, unlike the secret. Must be present when
# `pnpm build` builds apps/web (e.g. copy into apps/web/.env on Railway).
VITE_SHOPIFY_API_KEY=replace
SHOPIFY_REDIRECT_URI=https://app.example.com/shopify/callback
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_inventory,read_locations,read_checkouts,read_price_rules
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_SECRET=replace
TRACKING_SECRET=replace
# PR #49 — AI Executive reuses STORE_COACH_API_KEY (defined in the Store Coach
# block below). OPENROUTER_API_KEY / OPENROUTER_API_KEY_1 are accepted as
# fallbacks if STORE_COACH_API_KEY is unset. No separate key exists for AI
# Executive. A Railway variable change requires a service restart.
AI_EXECUTIVE_ENABLED=true
AI_EXECUTIVE_MODEL_PRIMARY=nvidia/nemotron-3-ultra:free
AI_EXECUTIVE_MODEL_FALLBACK=nvidia/nemotron-3-super:free
AI_EXECUTIVE_RATE_LIMIT_PER_STORE=20
AI_EXECUTIVE_DAILY_BUDGET_USD=0
AI_EXECUTIVE_PDF_ENABLED=true
# Optional: persist generated investor PDFs to a local directory. When unset,
# PDFs are kept in memory for the process lifetime (dev/test default).
AI_EXECUTIVE_PDF_DIR=
AI_EXECUTIVE_BENCHMARK_MODE=hybrid

# OPENROUTER_API_KEY is also accepted as a fallback for OPENROUTER_API_KEY_1.
OPENROUTER_API_KEY_1=replace
OPENROUTER_API_KEY_2=replace
OPENROUTER_API_KEY_3=replace
# Jarvis cloud text-to-speech (natural human voice, like ChatGPT). Optional:
# when unset, Jarvis uses the browser voice instead. Any OpenAI-compatible
# /audio/speech endpoint works. NEVER commit a real key; put it in the
# Railway dashboard only.
#
# --- Option A (RECOMMENDED): Fish Audio S2.1 Pro via OpenRouter ---
# Best quality; multilingual. Get a key at openrouter.ai/keys. Fish Audio uses
# VOICE REFERENCE IDs (the hex id in a fish.audio voice page URL, /m/<id>/).
# You can set language-specific voices so a Hindi reply uses a Hindi voice and
# an English reply uses an English voice. The FEMININE/MASCULINE defaults below
# are the fallback when a per-language voice is not set.
# JARVIS_TTS_API_KEY=sk-or-v1-xxx
# JARVIS_TTS_BASE_URL=https://openrouter.ai/api/v1
# JARVIS_TTS_MODEL=fish-audio/s2.1-pro
# English voices
# JARVIS_TTS_VOICE_EN_FEMININE=933563129e564b19a115bedd57b7406a
# JARVIS_TTS_VOICE_EN_MASCULINE=802e3bc2b27e49c2995d23ef70e6ac89
# Hindi voices
# JARVIS_TTS_VOICE_HI_FEMININE=aab4d9c3cc3f4a7e9dd4a890c682a114
# JARVIS_TTS_VOICE_HI_MASCULINE=b79b6174191548d08af0fb6bf0396127
# (optional) gender-only fallback for any language not covered above
# JARVIS_TTS_VOICE_FEMININE=933563129e564b19a115bedd57b7406a
# JARVIS_TTS_VOICE_MASCULINE=802e3bc2b27e49c2995d23ef70e6ac89
#
# --- Option B: OpenAI TTS (paid, built-in named voices, multilingual) ---
# JARVIS_TTS_API_KEY=sk-xxx
# JARVIS_TTS_BASE_URL=https://api.openai.com/v1
# JARVIS_TTS_MODEL=gpt-4o-mini-tts
# JARVIS_TTS_VOICE_FEMININE=shimmer
# JARVIS_TTS_VOICE_MASCULINE=echo
#
# --- Option C: Grok Voice TTS via OpenRouter (zero-setup voices) ---
# Built-in named voices (eve/ara female, leo/rex male), 20+ languages auto-detect.
# JARVIS_TTS_API_KEY=sk-or-v1-xxx
# JARVIS_TTS_BASE_URL=https://openrouter.ai/api/v1
# JARVIS_TTS_MODEL=x-ai/grok-voice-tts-1.0
# JARVIS_TTS_VOICE_FEMININE=eve
# JARVIS_TTS_VOICE_MASCULINE=leo
JARVIS_TTS_API_KEY=
JARVIS_TTS_BASE_URL=https://openrouter.ai/api/v1
JARVIS_TTS_MODEL=fish-audio/s2.1-pro
# Audio container: mp3 (works on OpenRouter/OpenAI/Fish). Use wav if a provider needs it.
JARVIS_TTS_RESPONSE_FORMAT=mp3
# Optional playback speed (0.5-2.0). Left empty = omitted for max compatibility.
JARVIS_TTS_SPEED=
JARVIS_TTS_TIMEOUT_MS=15000
# Verified active free endpoints on 2026-08-18.
AI_MODEL_PRIMARY=openai/gpt-oss-20b:free
AI_MODEL_FALLBACK1=nvidia/nemotron-3-nano-omni:free
AI_MODEL_FALLBACK2=nvidia/nemotron-3-super:free
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000
AI_COMMAND_ENABLED=true
AI_COMMAND_API_KEY=
AI_COMMAND_MODEL_PRIMARY=cohere/north-mini-code:free
AI_COMMAND_MODEL_FALLBACK=nvidia/nemotron-3-nano-omni:free
AI_COMMAND_RATE_LIMIT_PER_STORE=30
AI_COMMAND_DAILY_BUDGET_USD=0
AI_COMMAND_ACTIONS_ENABLED=true
AI_COMMAND_MAX_ACTIONS_PER_COMMAND=10
AI_COMMAND_CONFIRMATION_TIMEOUT_SECONDS=30
AI_COMMAND_CONVERSATION_MEMORY_HOURS=24
AI_DAILY_COST_CAP_USD=5.00
# Per-token rates in micro-dollars. The default models are OpenRouter :free
# variants (rate 0), but the metering structure is real: set these to the
# listed OpenRouter prices when switching to paid models, e.g. a model at
# $0.50 / 1M input tokens is AI_INPUT_MICRO_DOLLARS=0.5.
AI_INPUT_MICRO_DOLLARS=0
AI_OUTPUT_MICRO_DOLLARS=0
# Parallel AI calls per analysis run and the per-run signal ceiling.
AI_RUN_CONCURRENCY=3
AI_RUN_SIGNAL_CAP=100
ENCRYPTION_KEY=replace-with-32-byte-hex-key
JWT_SECRET=replace-with-at-least-32-characters
JWT_ISSUER=profitpilot
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CSRF_SECRET=replace-with-at-least-32-characters
SECURITY_REQUIRE_AUTH=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_WINDOW_MS=60000
# F9 accepts either R2_* or CLOUDFLARE_R2_* names.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=profitpilot-reports
R2_ACCESS_KEY_ID=replace
R2_SECRET_ACCESS_KEY=replace
# CLOUDFLARE_R2_ENDPOINT=...
# CLOUDFLARE_R2_BUCKET=...
# CLOUDFLARE_R2_ACCESS_KEY_ID=...
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=...
SHOPIFY_HEALTH_SHOP=
SHOPIFY_HEALTH_ACCESS_TOKEN=
SENTRY_DSN=
SENTRY_ENABLED=false
RELEASE_VERSION=development
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
REPORT_TICK_INTERVAL_MS=3600000
# Production defaults to applying pending migrations on API boot so new
# tables (AI Executive 0022, Store Coach 0023, PatternAI 0024 + 0025) exist
# after a deploy. Set false only when you run migrations out-of-band.
RUN_MIGRATIONS=false
# Consecutive Shopify 5xx/429/transport failures before a store's sync circuit
# opens, and how long it stays open before it half-opens automatically.
SYNC_CIRCUIT_FAILURE_THRESHOLD=3
SYNC_CIRCUIT_COOLDOWN_MS=60000
LEGAL_ENTITY_NAME=Anash Ali
LEGAL_ENTITY_ADDRESS=Tanda Mallu Ramnagar Uttarakhand 244715
LEGAL_JURISDICTION=Uttarakhand India
SUPPORT_EMAIL=anasanasali1714@gmail.com
ADMIN_KEY=replace-with-admin-key
# true | false | auto (default). "auto" detects development/partner-test shops
# and forces test charges, which Shopify requires there (a live charge is 422).
SHOPIFY_BILLING_TEST_MODE=auto
SHOPIFY_BILLING_TRIAL_DAYS=14
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=merchant-system@example.com
SMTP_PASSWORD=replace
SMTP_FROM=merchant-system@example.com
SMTP_FROM_NAME=ProfitPilot
SMTP_SECURE=false
MERCHANT_EMAIL_VERIFICATION_SECRET=replace
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=replace
TWILIO_AUTH_TOKEN=replace
TWILIO_PHONE_NUMBER=replace
GIFT_CODE_ENABLED=true
GIFT_CODE_1=KASSAR786
GIFT_CODE_1_MAX_USES=100
GIFT_CODE_1_ACTIVE=true
GIFT_CODE_2=AFRIDI786
GIFT_CODE_2_MAX_USES=10000
GIFT_CODE_2_ACTIVE=true
LOG_LEVEL=info

# --- PR #48: Store Coach (AI Growth Command) ---
# OpenRouter key for the Store Coach AI. The two free NVIDIA Nemotron models
# below are the primary/fallback pair; both are :free tier (daily cost $0).
STORE_COACH_API_KEY=replace
STORE_COACH_MODEL_PRIMARY=nvidia/nemotron-3-ultra:free
STORE_COACH_MODEL_FALLBACK=nvidia/nemotron-3-super:free
# Master switch + feature flags.
STORE_COACH_ENABLED=true
STORE_COACH_VOICE_ENABLED=true
STORE_COACH_BETA=false
# Per-store AI request ceiling per minute (free-tier friendly).
STORE_COACH_RATE_LIMIT_PER_STORE=30
STORE_COACH_DAILY_BUDGET_USD=0
# Default coach personality + huddle time (minutes since midnight, merchant tz).
STORE_COACH_DEFAULT_PERSONALITY=professional
STORE_COACH_DEFAULT_HUDDLE_TIME=07:00
# ── PatternAI (formerly Insights Hub) — AI Growth Command discovery module ──
# Variable names keep the INSIGHTS_HUB_ prefix so existing deployments are not
# broken by the rebrand; the product surface is PatternAI.
# Master switch. false 503s /patternai + /insights and skips worker sweeps.
INSIGHTS_HUB_ENABLED=true
# Dedicated OpenRouter key for the PatternAI narrator. The narrator only
# rephrases deterministic engine output through the language firewall — it
# never supplies numbers. The real value was delivered in the Arena chat
# thread (2026-08-18) and lives ONLY in the Railway dashboard (api + worker
# services) — never commit it to this public repository (GitHub push
# protection blocks it, and scrapers would revoke it).
INSIGHTS_HUB_API_KEY=replace
INSIGHTS_HUB_MODEL_PRIMARY=nvidia/nemotron-3.5-lightning:free
INSIGHTS_HUB_MODEL_FALLBACK=nvidia/nemotron-3-super:free
# Per-store merchant-facing rate limit (requests/minute).
INSIGHTS_HUB_RATE_LIMIT_PER_STORE=25
# Free-tier models keep this at $0/day; raise only after switching to paid models.
INSIGHTS_HUB_DAILY_BUDGET_USD=0
INSIGHTS_HUB_AUTO_DISCOVERY_ENABLED=true
# daily (2:00 AM UTC) | weekly (Sunday) | realtime (Commander)
INSIGHTS_HUB_DISCOVERY_FREQUENCY=daily
# Discoveries below this confidence never surface to merchants.
INSIGHTS_HUB_MIN_CONFIDENCE_SCORE=0.7
INSIGHTS_HUB_TREND_MONITORING=true
# External market trends only render when a verified benchmark feed exists;
# PatternAI never invents market data.
INSIGHTS_HUB_EXTERNAL_TRENDS=true
# Commander public API (Bearer ihk_ keys). Requests/hour per store.
INSIGHTS_HUB_API_ACCESS_ENABLED=true
INSIGHTS_HUB_API_RATE_LIMIT=100
# Worker → API base for the auto-discovery sweep (defaults to local API).
INSIGHTS_HUB_API_BASE_URL=http://127.0.0.1:3000
