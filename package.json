{
  "name": "profitpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProfitPilot \u2014 your AI employee for Shopify",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "corepack pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "corepack pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:security": "vitest run apps/api/src/security.test.ts",
    "test:load": "vitest run apps/api/src/load.test.ts",
    "test:a11y": "vitest run apps/web/src/accessibility.test.ts",
    "generate:shopify": "node --experimental-strip-types scripts/generate-shopify-app-toml.ts",
    "lint": "corepack pnpm -r --workspace-concurrency=1 run lint"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4",
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "pg": "^8.23.0"
  }
}
